<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; color: #333; line-height: 1.6; margin: 0; }
        .container { max-width: 600px; margin: 0 auto; }
        .header { background-color: #2c3e50; color: white; padding: 20px; }
        .header h1 { margin: 0 0 5px 0; font-size: 24px; }
        .timestamp { font-size: 12px; opacity: 0.9; }
        .content { background-color: #ecf0f1; padding: 20px; }
        .box { background-color: white; margin: 10px 0; padding: 15px; border-left: 4px solid #e74c3c; }
        .count { font-size: 32px; font-weight: bold; color: #e74c3c; }
        .box-title { font-weight: bold; font-size: 14px; margin-bottom: 10px; }
        .box-critical { border-left-color: #e74c3c; }
        .box-warning { border-left-color: #f39c12; }
        .box-new { border-left-color: #3498db; }
        ul { margin: 5px 0; padding-left: 20px; }
        li { margin: 5px 0; }
        .footer { background-color: #34495e; color: white; padding: 10px; text-align: center; font-size: 11px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔴 RVTools Issues Report</h1>
            <p class="timestamp">{{ generated_at }}</p>
        </div>

        <div class="content">
            <!-- Primary Status: New Issues -->
            {% set total_new_items = new_items|length %}
            {% if total_new_items == 0 %}
            <div class="box" style="border-left-color: #27ae60; background-color: #e6ffe6; text-align: center;">
                <p style="font-size: 32px; margin: 10px 0;">🟢</p>
                <p style="font-size: 18px; font-weight: bold; color: #27ae60; margin: 5px 0;">No New Issues</p>
            </div>
            {% elif total_new_items <= 5 %}
            <div class="box" style="border-left-color: #f39c12; background-color: #fff4e6; text-align: center;">
                <p style="font-size: 32px; margin: 10px 0;">🟡</p>
                <p style="font-size: 18px; font-weight: bold; color: #f39c12; margin: 5px 0;">{{ total_new_items }} New Issue{% if total_new_items > 1 %}s{% endif %} Found</p>
            </div>
            {% else %}
            <div class="box" style="border-left-color: #e74c3c; background-color: #ffe6e6; text-align: center;">
                <p style="font-size: 32px; margin: 10px 0;">🔴</p>
                <p style="font-size: 18px; font-weight: bold; color: #e74c3c; margin: 5px 0;">{{ total_new_items }} New Issues Found</p>
            </div>
            {% endif %}

            <!-- New Issues Detail (if any) -->
            {% if new_items %}
            <div class="box box-new">
                <div class="box-title">🆕 New Issues Detected ({{ new_items|length }})</div>
                <ul>
                {% for item in new_items %}
                    <li>{{ item }}</li>
                {% endfor %}
                </ul>
            </div>
            {% endif %}

            <!-- Previously Known Issues Summary -->
            {% set known_critical = critical_items|length %}
            {% set known_warnings = warning_items|length %}
            {% set total_known = known_critical + known_warnings %}
            {% if total_known > 0 %}
            <div class="box" style="border-left-color: #95a5a6; background-color: #f8f9fa;">
                <div class="box-title" style="color: #7f8c8d;">Previously Known Issues ({{ total_known }})</div>
                <ul style="color: #7f8c8d;">
                {% if critical_items %}
                    {% for item in critical_items %}
                    <li>🔴 {{ item }}</li>
                    {% endfor %}
                {% endif %}
                {% if warning_items %}
                    {% for item in warning_items %}
                    <li>⚡ {{ item }}</li>
                    {% endfor %}
                {% endif %}
                </ul>
            </div>
            {% endif %}

            <p style="margin-top: 20px; font-size: 11px; color: #7f8c8d; text-align: center;">
                Full details in attached reports
            </p>
        </div>

        <div class="footer">
            <p>RVTools Analysis System</p>
        </div>
    </div>
</body>
</html>
