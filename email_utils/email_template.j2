<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RVTools Analysis Report</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background-color: #f5f5f5; color: #333; line-height: 1.6; }
        .container { max-width: 750px; margin: 20px auto; background-color: #ffffff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border-radius: 8px; overflow: hidden; }
        .header { background: linear-gradient(135deg, #374ACB 0%, #62A5FE 100%); color: white; padding: 32px 24px; text-align: left; }
        .header h1 { font-size: 24px; margin-bottom: 8px; }
        .header-subtitle { font-size: 14px; opacity: 0.9; }
        .content { padding: 24px; }
        .status-box { padding: 20px; border-radius: 6px; margin-bottom: 24px; text-align: center; border: 1px solid #ddd; }
        .status-box.success { background-color: #f0fef0; border-color: #27ae60; color: #27ae60; }
        .status-box.warning { background-color: #fffaf0; border-color: #f39c12; color: #f39c12; }
        .status-box.critical { background-color: #fef0f0; border-color: #e74c3c; color: #e74c3c; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
        .stat-card { background: #f9f9f9; padding: 16px; border-radius: 6px; text-align: center; border: 1px solid #eee; }
        .stat-label { font-size: 12px; color: #666; text-transform: uppercase; margin-bottom: 4px; }
        .stat-value { font-size: 24px; font-weight: bold; color: #374ACB; }
        .section-title { font-size: 18px; font-weight: 600; margin: 24px 0 12px; padding-bottom: 8px; border-bottom: 2px solid #eee; }
        .issue-group { margin-bottom: 16px; border: 1px solid #eee; border-radius: 6px; overflow: hidden; }
        .group-header { background: #fcfcfc; padding: 10px 15px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
        .group-label { font-weight: 600; font-size: 14px; }
        .group-count { background: #374ACB; color: white; font-size: 11px; padding: 2px 8px; border-radius: 10px; }
        .critical .group-count { background: #e74c3c; }
        .warning .group-count { background: #f39c12; }
        .item-list { list-style: none; }
        .item-row { padding: 8px 15px; border-bottom: 1px solid #f9f9f9; font-size: 13px; }
        .item-row:last-child { border-bottom: none; }
        .item-row strong { color: #333; }
        .item-detail { font-size: 12px; color: #666; margin-top: 2px; }
        .footer { background-color: #f9f9f9; color: #666; padding: 20px; text-align: center; font-size: 12px; border-top: 1px solid #eee; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 RVTools Infrastructure Report</h1>
            <div class="header-subtitle">Health Assessment Generated on {{ generated_at }}</div>
        </div>

        <div class="content">
            {% set total_new = new_summary|sum(attribute='count') %}
            {% if total_new == 0 %}
                <div class="status-box success">
                    <h3>✓ No New Issues</h3>
                    <p>Infrastructure state is consistent with previous analysis.</p>
                </div>
            {% else %}
                <div class="status-box critical">
                    <h3>⚠ {{ total_new }} New Issues Detected</h3>
                    <p>Review the details below and take appropriate action.</p>
                </div>
            {% endif %}

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">Total Anomalies</div>
                    <div class="stat-value">{{ total_issues }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">New Since Last Run</div>
                    <div class="stat-value" style="color: #e74c3c;">{{ total_new }}</div>
                </div>
            </div>

            {% if new_summary %}
            <h2 class="section-title" style="color: #374ACB;">🆕 New Anomalies</h2>
            {% for group in new_summary %}
            <div class="issue-group new">
                <div class="group-header">
                    <span class="group-label">{{ group.label }}</span>
                    <span class="group-count">{{ group.count }}</span>
                </div>
                <ul class="item-list">
                    {% for item in group.issue_list %}
                    <li class="item-row">
                        <strong>{{ item.name or item.vm or 'Unknown' }}</strong>
                        <div class="item-detail">
                            {% if item.message %}{{ item.message }}{% endif %}
                            {% if item.disk %}| Disk: {{ item.disk }}{% endif %}
                            {% if item.free_percent %}| Free: {{ item.free_percent }}%{% endif %}
                            {% if item['free_%'] %}| Free: {{ item['free_%'] }}%{% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
            {% endif %}

            {% if critical_summary %}
            <h2 class="section-title" style="color: #e74c3c;">🔴 Critical Issues (All)</h2>
            {% for group in critical_summary %}
            <div class="issue-group critical">
                <div class="group-header">
                    <span class="group-label">{{ group.label }}</span>
                    <span class="group-count">{{ group.count }}</span>
                </div>
                <ul class="item-list">
                    {% for item in group.issue_list %}
                    <li class="item-row">
                        <strong>{{ item.name or item.vm or 'Unknown' }}</strong>
                        <div class="item-detail">
                            {% if item.message %}{{ item.message }}{% endif %}
                            {% if item.disk %}| Disk: {{ item.disk }}{% endif %}
                        </div>
                    </li>
                    {% endfor %}
                    {% if group.count > 5 %}<li class="item-row" style="color: #999;">... and {{ group.count - 5 }} more (see attached report)</li>{% endif %}
                </ul>
            </div>
            {% endfor %}
            {% endif %}

            {% if warning_summary %}
            <h2 class="section-title" style="color: #f39c12;">⚡ Warning Issues (All)</h2>
            {% for group in warning_summary %}
            <div class="issue-group warning">
                <div class="group-header">
                    <span class="group-label">{{ group.label }}</span>
                    <span class="group-count">{{ group.count }}</span>
                </div>
                <ul class="item-list">
                    {% for item in group.issue_list %}
                    <li class="item-row">
                        <strong>{{ item.name or item.vm or 'Unknown' }}</strong>
                    </li>
                    {% endfor %}
                    {% if group.count > 5 %}<li class="item-row" style="color: #999;">... and {{ group.count - 5 }} more</li>{% endif %}
                </ul>
            </div>
            {% endfor %}
            {% endif %}
        </div>

        <div class="footer">
            <p><strong>RVTools Analysis System</strong></p>
            <p>Full detailed reports are attached to this email.</p>
        </div>
    </div>
</body>
</html>
